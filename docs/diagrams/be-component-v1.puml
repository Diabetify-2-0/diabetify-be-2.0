@startuml
top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam ArrowThickness 1
skinparam nodesep 55
skinparam ranksep 60

title Diabetify 1.0 Backend Component Diagram

package "Diabetify Backend API" {
  package "Presentation Layer" {
    [API Routes] as Routes
    [Auth Middleware] as AuthMW
    [User & Auth Controller] as UserCtrl
    [OAuth Controller] as OAuthCtrl
    [Verification Controller] as VerifyCtrl
    [User Profile Controller] as ProfileCtrl
    [Activity Controller] as ActivityCtrl
    [Prediction Controller] as PredictCtrl
  }

  package "Business Layer" {
    [Prediction Job Worker] as JobWorker
    [Prediction Explanation Logic] as ExplainSvc
  }

  package "Data Access Layer" {
    [Repository Layer] as Repos
    [GORM / Database Access] as GormDB
  }

  package "Integration Layer" {
    package "User Support Integration" {
      [Email Utility] as Email
    }

    package "Prediction Support Integration" {
      [ML Client] as MLClient
      [Redis Client] as RedisClient
      [OpenAI Client] as OpenAIClient
    }
  }
}

package "External Systems / Infrastructure" {
  database "PostgreSQL Database" as PostgreSQL
  [SMTP Server] as SMTP
  [Google OAuth] as GoogleAuth
  [RabbitMQ Message Broker] as RabbitMQ
  [ML Prediction Service] as MLService
  [Redis Cache] as Redis
  [OpenAI API] as OpenAIAPI
}

Routes --> AuthMW : secured endpoints
Routes --> UserCtrl : public endpoints
Routes --> OAuthCtrl : Google OAuth login
Routes --> VerifyCtrl : verification endpoints

AuthMW --> UserCtrl : /users/me
AuthMW --> ProfileCtrl
AuthMW --> ActivityCtrl
AuthMW --> PredictCtrl

UserCtrl --> Repos
UserCtrl --> Email

OAuthCtrl --> Repos
OAuthCtrl --> GoogleAuth : verify ID token

VerifyCtrl --> Repos
VerifyCtrl --> Email

Email --> SMTP : send email

ProfileCtrl --> Repos
ActivityCtrl --> Repos

PredictCtrl --> Repos
PredictCtrl --> JobWorker
PredictCtrl --> ExplainSvc

ExplainSvc --> OpenAIClient
ExplainSvc --> Repos
OpenAIClient --> OpenAIAPI : generate explanation
  
JobWorker --> Repos
JobWorker --> MLClient
JobWorker --> RabbitMQ : consume prediction result
JobWorker --> RedisClient

MLClient --> RabbitMQ : publish prediction request

RabbitMQ --> MLService : deliver request

MLService --> RabbitMQ : publish prediction result

RedisClient --> Redis

Repos --> GormDB
GormDB --> PostgreSQL : query data



@enduml
