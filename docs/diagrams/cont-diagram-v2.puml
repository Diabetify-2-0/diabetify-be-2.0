@startuml
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowThickness 1
skinparam nodesep 65
skinparam ranksep 80

title Diabetify 2.0 Container Diagram - XAI-HITL Ecosystem

actor "Pengguna" as User
actor "Admin / Operator" as Admin
actor "Data Scientist /\nML Engineer" as DataScientist
actor "Medical Expert /\nReviewer" as Reviewer

package "Sistem Diabetify 2.0" {
  package "User-Facing Containers" {
    rectangle "Aplikasi Diabetify Mobile\n[Android App]\nKotlin + Jetpack Compose" as Mobile

    rectangle "Diabetify Control Panel\n[Web Application]\nMonitoring, validasi, dan approval" as ControlPanel

    rectangle "Diabetify Backend API\n[Application]\nGo + Gin" as Backend
  }

  package "XAI & ML Service Containers" {
    rectangle "ML Prediction Service\n[Application]\nPython + XGBoost + SHAP" as ML

    rectangle "Counterfactual Planner Service\n[Application]\nOptimization-based actionable planning" as CF

    rectangle "XAI Chatbot / RAG Service\n[Application]\nConversational XAI with retrieval" as RAG
  }

  package "Model Governance Containers" {
    rectangle "Continual Learning &\nModel Governance Service\n[Application]\nDrift detection, training,\nevaluation, and shadow validation" as Governance

    database "Model Registry\n[Data Store]\nProduction, candidate, and archived models" as ModelRegistry
  }

  package "Data & Infrastructure Containers" {
    database "PostgreSQL Database\n[Data Store]\nOperational data, jobs, feedback,\nchat history, validation, and audit logs" as DB

    queue "RabbitMQ\n[Message Broker]\nAsynchronous prediction and counterfactual" as MQ

    collections "Redis Cache\n[Cache]\nTemporary job results and session cache" as Redis

    database "Vector Store / Knowledge Base\n[Data Store]\nMedical guideline chunks and embeddings" as VectorDB
  }
}

cloud "Google OAuth\n[External System]" as Google
cloud "SMTP Server\n[External System]" as SMTP
cloud "LLM Provider\n[External System]" as LLM
cloud "Sumber Pedoman Medis\n[External Source]" as MedicalSources

User --> Mobile : Menggunakan prediksi,\nrekomendasi, dan chatbot XAI
Admin --> ControlPanel : Memantau operasional sistem, status layanan, dan aktivitas
DataScientist --> ControlPanel : Mengevaluasi drift, melakukan retraining, dan menyiapkan model challenger
Reviewer --> ControlPanel : Memvalidasi aspek medis model challenger\ndan memberikan persetujuan klinis

Mobile --> Backend : REST API requests
ControlPanel --> Backend : Internal user API requests 

Backend --> Google : Verifikasi token Google
Backend --> SMTP : Email verifikasi,\nreset password, dan notifikasi
Backend --> DB : CRUD data operasional
Backend --> Redis : Cache hasil sementara
Backend --> MQ : Publish prediction and\ncounterfactual jobs
MQ --> Backend : Deliver prediction and\ncounterfactual results
Backend --> RAG : XAI chat and explanation request
Backend --> Governance : Trigger lifecycle tasks,\nsubmit approvals, retrieve reports
Backend --> ModelRegistry : Review model versions\nand active model metadata
Backend --> VectorDB : Manage curated medical\nknowledge base

MQ --> ML : Prediction request
ML --> MQ : Prediction result

MQ --> CF : Counterfactual planning request
CF --> MQ : Counterfactual result
CF --> ML : Evaluate candidate scenarios
CF --> ModelRegistry : Read active model metadata

RAG --> VectorDB : Retrieve medical context
RAG --> LLM : Generate grounded response
RAG --> DB : Store conversation metadata

Backend --> MedicalSources : Retrieve reference documents\nfor knowledge-base curation

Governance --> DB : Read historical data,\nfeedback, and validation metrics
Governance --> ModelRegistry : Store and compare model versions
Governance --> ML : Run shadow prediction validation



@enduml
