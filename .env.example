# Core runtime
APP_ENV=dev
PORT=8080
USE_SHARDING=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=diabetify
DB_SSLMODE=disable

# RabbitMQ
RABBITMQ_URL=amqp://admin:password123@localhost:5672/
RABBITMQ_MANAGEMENT_PORT=25672

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=diabetify-dev-secret-change-me

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# AI services
OPENAI_API_KEY=

# CORS — comma-separated allowed origins
# Dev: http://localhost:5173 (Vite) atau http://localhost:3000 (docker web)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional MLOps proxy routes (/data and /expert)
MLOPS_SERVICE_URL=http://localhost:8000
